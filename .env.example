# ==============================================================================
# LifeDesk AI — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env before starting your application:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit .env or paste private production secrets into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Required for AI assistant chat, note summarization, task prioritization,
# expense financial insights, and document Q&A.
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration (PostgreSQL Database & Auth)
# ------------------------------------------------------------------------------
# Optional for local demo mode; Required for multi-device sync and cloud auth.
# Obtain these credentials from your Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"

# Standalone backend server keys (Required only if deploying python microservice)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. Application Server Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 4. Optional Webhook / CI/CD Deployment Hooks
# ------------------------------------------------------------------------------
# Optional webhook URL for triggering automatic deployments on push to main
# RENDER_DEPLOY_HOOK_URL="https://api.render.com/deploy/srv-xxxx?key=yyyy"


